----------------------------------------------------------------
-- Theme
----------------------------------------------------------------
local ACCENT_1 = Color3.fromRGB(140, 90, 255)
local ACCENT_2 = Color3.fromRGB(60, 190, 255)
local BG_TOP = Color3.fromRGB(28, 26, 40)
local BG_BOTTOM = Color3.fromRGB(16, 16, 24)
local CARD = Color3.fromRGB(34, 34, 48)
local CARD_HOVER = Color3.fromRGB(46, 44, 66)
local TEXT = Color3.fromRGB(240, 240, 245)
local SUBTEXT = Color3.fromRGB(150, 150, 170)
local GREEN = Color3.fromRGB(90, 220, 130)
local RED = Color3.fromRGB(255, 90, 100)
local YELLOW = Color3.fromRGB(255, 200, 80)

----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------
local function new(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    inst.Parent = parent
    return inst
end

local function tween(obj, time, goal, style, dir)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        goal
    )
    t:Play()
    return t
end

local function getParent()
    local ok, res = pcall(function()
        return (gethui and gethui()) or game:GetService("CoreGui")
    end)
    if ok and res then
        return res
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function accentGradient(parent)
    return new("UIGradient", {
        Color = ColorSequence.new(ACCENT_1, ACCENT_2),
    }, parent)
end

-- remove old copy if re-executed
local parentGui = getParent()
local old = parentGui:FindFirstChild("NemoHub")
if old then
    old:Destroy()
end

local connections = {}
local function connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(connections, c)
    return c
end

