local function makeCard(g, index)
    local isCurrent = currentGame == g

    local card = new("CanvasGroup", {
        Name = g.name,
        LayoutOrder = index,
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0,
        GroupTransparency = 1,
    }, list)
    new("UICorner", { CornerRadius = UDim.new(0, 12) }, card)

    -- accent bar
    local bar = new("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = isCurrent and GREEN or ACCENT_1,
        BorderSizePixel = 0,
    }, card)
    if not isCurrent then
        accentGradient(bar).Rotation = 90
    end

    new("TextLabel", {
        Position = UDim2.fromOffset(16, 8),
        Size = UDim2.new(1, -110, 0, 20),
        BackgroundTransparency = 1,
        Text = g.name,
        TextColor3 = TEXT,
        TextSize = 16,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, card)

    new("TextLabel", {
        Position = UDim2.fromOffset(16, 29),
        Size = UDim2.new(1, -110, 0, 16),
        BackgroundTransparency = 1,
        Text = "ID: " .. tostring(g.id),
        TextColor3 = SUBTEXT,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)

    -- card hover
    connect(card.MouseEnter, function()
        tween(card, 0.15, { BackgroundColor3 = CARD_HOVER })
    end)
    connect(card.MouseLeave, function()
        tween(card, 0.15, { BackgroundColor3 = CARD })
    end)

    -- small badge only on the game you're currently in
    if isCurrent then
        local badge = new("TextLabel", {
            Name = "CurrentBadge",
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.fromOffset(84, 28),
            BackgroundColor3 = Color3.fromRGB(40, 70, 52),
            Text = "Current",
            TextColor3 = GREEN,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            BorderSizePixel = 0,
        }, card)
        new("UICorner", { CornerRadius = UDim.new(0, 9) }, badge)
    end

    -- staggered fade-in
    task.delay(0.35 + index * 0.08, function()
        if card.Parent then
            tween(card, 0.35, { GroupTransparency = 0 })
        end
    end)
end

for i, g in ipairs(GAMES) do
    makeCard(g, i)
end

----------------------------------------------------------------
-- Dragging
----------------------------------------------------------------
do
    local dragging, dragStart, startPos
    connect(header.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = root.Position
            local c
            c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    c:Disconnect()
                end
            end)
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            root.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
end

----------------------------------------------------------------
-- Open / close animations (+ RightShift to hide/show)
----------------------------------------------------------------
local closing = false
local function destroyHub()
    if closing then
        return
    end
    closing = true
    tween(uiScale, 0.25, { Scale = 0.8 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    tween(main, 0.25, { GroupTransparency = 1 })
    tween(shadow, 0.25, { ImageTransparency = 1 })
    task.delay(0.3, function()
        for _, c in ipairs(connections) do
            c:Disconnect()
        end
        gui:Destroy()
    end)
end
connect(closeBtn.MouseButton1Click, destroyHub)

local hidden = false
connect(UserInputService.InputBegan, function(input, processed)
    if processed or closing then
        return
    end
    if input.KeyCode == Enum.KeyCode.RightShift then
        hidden = not hidden
        if hidden then
            tween(uiScale, 0.2, { Scale = 0.8 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            tween(main, 0.2, { GroupTransparency = 1 })
            tween(shadow, 0.2, { ImageTransparency = 1 })
            task.delay(0.2, function()
                if hidden then
                    root.Visible = false
                end
            end)
        else
            root.Visible = true
            tween(uiScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
            tween(main, 0.25, { GroupTransparency = 0 })
            tween(shadow, 0.25, { ImageTransparency = 0.55 })
        end
    end
end)

tween(uiScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
tween(main, 0.35, { GroupTransparency = 0 })
tween(shadow, 0.35, { ImageTransparency = 0.55 })

----------------------------------------------------------------
-- Script loading (same logic as before)
----------------------------------------------------------------
if not currentGame then
    warn("[NemoHub] Unsupported game (PlaceId: " .. game.PlaceId .. ")")
    setStatus("Game not supported", RED)
    return
end

task.spawn(function()
    task.wait(0.6)
    setStatus("Loading " .. currentGame.name .. "...", YELLOW)
    print("[NemoHub] Loading script for PlaceId", game.PlaceId)

    local ok, src = pcall(function()
        return game:HttpGet(currentGame.url)
    end)
    if not ok or not src then
        warn("[NemoHub] Failed to download:", tostring(src))
        setStatus("Failed to download script", RED)
        return
    end

    local chunk, err = loadstring(src)
    if not chunk then
        warn("[NemoHub] Syntax error:", err)
        setStatus("Script syntax error", RED)
        return
    end

    local runOk, runErr = pcall(chunk)
    if not runOk then
        warn("[NemoHub] Runtime error:", runErr)
        setStatus("Script runtime error", RED)
        return
    end

    -- supported game loaded: show a 5 second countdown, then close the hub
    for i = 5, 1, -1 do
        if closing or not gui.Parent then
            return
        end
        setStatus("Loaded: " .. currentGame.name .. " - closing in " .. i .. "s", GREEN)
        task.wait(1)
    end
    destroyHub()
end)
